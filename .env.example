# CommanderAI Configuration

# =============================================================================
# LLM Provider Settings
# =============================================================================

# Choose your LLM provider: openai, lmstudio, ollama, anthropic, groq, together
LLM_PROVIDER=openai

# Model to use (provider-specific)
# OpenAI: gpt-4o-mini, gpt-4o, gpt-4-turbo
# LM Studio: local-model (or your loaded model name)
# Ollama: llama3.2, mistral, codellama, etc.
# Anthropic: claude-3-5-sonnet-20241022
# Groq: llama-3.3-70b-versatile
# Together: meta-llama/Llama-3.3-70B-Instruct-Turbo
LLM_MODEL=gpt-4o-mini

# Base URL for local providers (optional)
# LM Studio: http://localhost:1234/v1
# Ollama: http://localhost:11434/v1
# LLM_BASE_URL=http://localhost:1234/v1

# =============================================================================
# API Keys (required for cloud providers)
# =============================================================================

# OpenAI API Key (for OpenAI provider)
OPENAI_API_KEY=

# Anthropic API Key (for Anthropic provider)
# ANTHROPIC_API_KEY=

# Groq API Key (for Groq provider)
# GROQ_API_KEY=

# Together AI API Key (for Together provider)
# TOGETHER_API_KEY=

# =============================================================================
# Examples
# =============================================================================

# --- Using LM Studio (local) ---
# LLM_PROVIDER=lmstudio
# LLM_MODEL=local-model
# LLM_BASE_URL=http://localhost:1234/v1

# --- Using Ollama (local) ---
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2
# LLM_BASE_URL=http://localhost:11434/v1

# --- Using Groq (fast cloud inference) ---
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=your-groq-api-key
